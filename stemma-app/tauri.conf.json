{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stemma",
  "version": "0.0.0",
  "identifier": "org.stemma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stemma",
        "width": 1480,
        "height": 940,
        "minWidth": 820,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "../identity/icons/32x32.png",
      "../identity/icons/128x128.png",
      "../identity/icons/128x128@2x.png",
      "../identity/icons/icon.png",
      "../identity/icons/icon.icns",
      "../identity/icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A daily working platform for mathematics research groups",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [
      "binaries/stemma"
    ]
  }
}
