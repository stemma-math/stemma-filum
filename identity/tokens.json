      "$value": "8px"
    },
    "radius-panel": {
      "$value": "10px"
    }
  },
  "density": {
    "$description": "How large controls are. Comfortable is the default; a surface opts into compact with data-density=\"compact\".",
    "comfortable": {
      "control-height": {
        "$type": "dimension",
        "$value": "40px"
      },
      "control-font": {
        "$type": "dimension",
        "$value": "{size.step-3}"
      },
      "control-small-font": {
        "$type": "dimension",
        "$value": "{size.step-2}"
      },
      "control-block": {
        "$type": "dimension",
        "$value": "{space.space-2}"
      },
      "control-inline": {
        "$type": "dimension",
        "$value": "{space.space-3}"
      },
      "button-inline": {
