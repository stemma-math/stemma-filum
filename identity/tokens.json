    "$type": "color",
    "paper": {
      "$value": "#f1f5f9",
      "$description": "Surfaces and ink."
    },
    "paper-raise": {
      "$value": "#ffffff"
    },
    "paper-sunk": {
      "$value": "#e9eff6"
    },
    "ink": {
