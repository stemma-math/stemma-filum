    },
    "rule-soft": {
      "$value": "#e6edf4"
    },
    "field": {
      "$value": "#f8fafc",
      "$description": "A control that takes typing."
    },
    "field-rule": {
      "$value": "#cbd7e5"
    },
    "ditto": {
      "$value": "#2d6de7",
      "$description": "Earned: a human commitment."
    },
    "ditto-strong": {
      "$value": "#205fcf",
      "$description": "Ditto under the pointer."
    },
    "verified": {
      "$value": "#0c7a66",
      "$description": "Earned: a machine proof."
    },
    "refuted": {
      "$value": "#b33b4a",
      "$description": "Earned: a refutation."
    },
    "night": {
      "$value": "#031a3b",
