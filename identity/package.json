{
  "name": "@stemma-math/identity",
  "version": "0.0.0",
  "private": true,
  "description": "Stemma's visual identity: design tokens, components, faces, the mark, the icons and shared drawings.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./tokens.typ": "./tokens.typ",
    "./components.css": "./components.css",
    "./fonts.css": "./fonts.css",
    "./glyphs.svg": "./glyphs.svg",
    "./mark-on-dark.svg": "./mark-on-dark.svg",
    "./mark-on-light.svg": "./mark-on-light.svg",
    "./mark-animated.js": "./mark-animated.js",
    "./symbol.webp": "./symbol.webp",
    "./noise.svg": "./noise.svg",
    "./descent.js": {
      "types": "./descent.d.ts",
      "default": "./descent.js"
    },
    "./web/*": "./web/*"
  },
  "files": [
    "*.css",
    "*.js",
    "*.d.ts",
    "*.svg",
    "tokens.json",
    "tokens.typ",
    "fonts",
    "icons",
    "web",
    "*.webp"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5"
  }
}
