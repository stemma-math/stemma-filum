{
  "name": "@stemma-math/identity",
  "version": "0.0.0",
  "private": true,
  "description": "Stemma's visual identity: design tokens, components, faces, the mark, the icons and shared drawings.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./tokens.typ": "./tokens/tokens.typ",
    "./fonts.css": "./css/fonts.css",
    "./components.css": "./css/components.css",
    "./glyphs.svg": "./images/glyphs.svg",
    "./noise.svg": "./images/noise.svg",
    "./mark-on-dark.svg": "./mark/on-dark.svg",
    "./mark-on-light.svg": "./mark/on-light.svg",
    "./mark-animated.js": "./mark/animated.js",
    "./symbol.webp": "./mark/symbol.webp",
    "./descent.js": {
      "types": "./js/descent.d.ts",
      "default": "./js/descent.js"
    },
    "./light.js": {
      "types": "./js/light.d.ts",
      "default": "./js/light.js"
    },
    "./icons/*": "./icons/*"
  },
  "files": [
    "tokens/tokens.css",
    "tokens/tokens.json",
    "tokens/tokens.typ",
    "css",
    "fonts",
    "mark",
    "images",
    "js",
    "icons"
  ],
  "scripts": {
    "build": "node tokens/build.mjs",
    "check": "node tokens/build.mjs --check"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.5"
  }
}
